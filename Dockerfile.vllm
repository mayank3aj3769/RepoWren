ARG VLLM_BASE_IMAGE=vllm/vllm-openai:v0.31.0-cu129
FROM ${VLLM_BASE_IMAGE}

# RepoWren serves text only. The CUDA 12.9 vLLM image currently resolves a
# TorchCodec binary linked against CUDA 13, which prevents vLLM from importing.
RUN python3 -m pip uninstall -y torchcodec --root-user-action=ignore
